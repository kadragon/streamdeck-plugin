{
	"Name": "Dev Toolkit",
	"Version": "0.6.0.0",
	"Author": "kadragon",
	"Actions": [
		{
			"Name": "Weekly Limit",
			"UUID": "com.kadragon.aiusage.limit",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Shows weekly rate-limit usage for Claude Code or Codex CLI.",
			"PropertyInspectorPath": "ui/weekly-limit.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "AI Usage Overview",
			"UUID": "com.kadragon.aiusage.overview",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Shows Claude Code and Codex CLI usage together.",
			"PropertyInspectorPath": "ui/usage-overview.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/usage-overview.json",
				"TriggerDescription": {
					"Push": "Cycle usage view",
					"Rotate": "View usage",
					"Touch": "View usage"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "System Monitor",
			"UUID": "com.kadragon.aiusage.system-monitor",
			"Icon": "imgs/actions/usage/icon",
			"Tooltip": "Shows selected local Windows system metric; CPU and GPU temperatures use the background color.",
			"PropertyInspectorPath": "ui/system-monitor.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Push": "No action",
					"Rotate": "View metric",
					"Touch": "View metric"
				}
			},
			"OS": ["windows"],
			"States": [
				{
					"Image": "imgs/actions/usage/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Warp URI",
			"UUID": "com.kadragon.aiusage.warp-uri",
			"Icon": "imgs/actions/warp-tab-config/icon",
			"Tooltip": "Opens a validated Warp or Warp Preview URI.",
			"PropertyInspectorPath": "ui/warp-uri.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/warp-tab-config/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Warp Tab Config",
			"UUID": "com.kadragon.aiusage.warp-tab-config",
			"Icon": "imgs/actions/warp-tab-config/icon",
			"Tooltip": "Opens a selected Warp Tab Config.",
			"PropertyInspectorPath": "ui/warp-tab-config.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/warp-tab-config/key",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "Dev Toolkit",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Shows AI usage, local Windows system metrics, and validated Warp launchers.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.kadragon.aiusage"
}
