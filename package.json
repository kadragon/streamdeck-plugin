{
    "name": "streamdeck-plugin",
    "version": "0.10.0",
    "private": true,
    "description": "Stream Deck plugin showing AI usage, local Windows system metrics, and Warp launchers.",
    "scripts": {
        "test": "tsx --test \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "build": "rollup -c",
        "check:principles": "node scripts/check-principles.mjs",
        "check:package": "node scripts/check-package.mjs",
        "check": "npm run typecheck && npm run check:principles && npm run build",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.kadragon.aiusage\""
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.3",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@tsconfig/node20": "^20.1.10",
        "@types/node": "~26.6.5",
        "rollup": "^4.65.0",
        "tslib": "^2.6.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.3",
        "undici": "^8.12.3"
    }
}
